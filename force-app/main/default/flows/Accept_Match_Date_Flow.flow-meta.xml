<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Set Confirmation Opponent</description>
        <name>Set_Confirmation_Opponent</name>
        <label>Set Confirmation Opponent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Match.Confirmation_Team_B__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Both_Confirmed_Decision</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Determine Side Decision</description>
        <name>Set_Confirmation_Player1</name>
        <label>Set Confirmation Player1</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Match.Confirmation_Team_A__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Both_Confirmed_Decision</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Set Final Date</description>
        <name>Set_Final_Date_Status</name>
        <label>Set Final Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Match.Final_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Match.Proposed_Date__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Match.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Accepted</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Save_Match</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <description>Both Confirmed Decision</description>
        <name>Both_Confirmed_Decision</name>
        <label>Both Confirmed Decision</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>NotAccepted</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Waiting</defaultConnectorLabel>
        <rules>
            <name>Both_Confirmed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Match.Confirmation_Team_A__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Match.Confirmation_Team_B__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Final_Date_Status</targetReference>
            </connector>
            <label>Both Confirmed</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determine Side Decision</description>
        <name>Determine_Side_Decision</name>
        <label>Determine Side Decision</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Both_Confirmed_Decision</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Neither</defaultConnectorLabel>
        <rules>
            <name>Player_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Match.Player_1__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Current_Player.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Confirmation_Player1</targetReference>
            </connector>
            <label>Player 1</label>
        </rules>
        <rules>
            <name>Opponent_Side</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Match.Opponent_Player__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Current_Player.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Confirmation_Opponent</targetReference>
            </connector>
            <label>Opponent Side</label>
        </rules>
    </decisions>
    <decisions>
        <name>Player_Found_Decision</name>
        <label>Player Found Decision</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>PlayerNotFound</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Current_Player.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Proposed_Date_Present_Decision</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Proposed_Date_Present_Decision</name>
        <label>Proposed Date Present Decision</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>DateNotFOund</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Proposal</defaultConnectorLabel>
        <rules>
            <name>Proposed_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Match.Proposed_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Determine_Side_Decision</targetReference>
            </connector>
            <label>Proposed Exists</label>
        </rules>
    </decisions>
    <description>Accept Match Date Flow</description>
    <dynamicChoiceSets>
        <name>ChooseYourName</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <object>Player__c</object>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <interviewLabel>Accept Match Date Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Accept Match Date Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Current_Player</name>
        <label>Get Current Player</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Player_Found_Decision</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Choose_Your_Name</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Player__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Match</name>
        <label>Get Match</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Confirm_Your_Identity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Match__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Save Match</description>
        <name>Save_Match</name>
        <label>Save Match</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Success</targetReference>
        </connector>
        <inputReference>Get_Match</inputReference>
    </recordUpdates>
    <screens>
        <description>Since shared login → user manually identifies themselves</description>
        <name>Confirm_Your_Identity</name>
        <label>Confirm Your Identity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Get_Current_Player</targetReference>
        </connector>
        <fields>
            <name>Choose_Your_Name</name>
            <choiceReferences>ChooseYourName</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Choose Your Name</fieldText>
            <fieldType>DropdownBox</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
